# 운영 환경 환경변수 예시
# 운영 서버에서 이 파일을 복사하여 .env.prod 를 만들고 실제 값을 입력하세요.
# .env.prod 는 절대 git에 커밋하지 마세요.
#Profile
PROFILE=prod

#Database
DB_URL=jdbc:mariadb://db:3306/myblog
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

#Json Web Token Secret Key
JWT_SECRET_KEY=

#Redis
REDIS_HOST=rediscache
REDIS_PORT=6379

#CORS Allowed
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

#HMAC Secret
VISITOR_HMAC_SECRET=
POST_VIEW_HMAC_SECRET=
POST_LIKE_HMAC_SECRET=

#AWS
AWS_S3_BUCKET_NAME=
AWS_CREDENTIALS_ACCESS_KEY=
AWS_CREDENTIALS_SECRET_KEY=

# App / SEO
APP_BASE_URL=https://your-domain.com
BLOG_TITLE=
BLOG_DESCRIPTION=

# Tag 개수 정책(기본 1~5)
BLOG_TAG_MIN_PER_POST=1
BLOG_TAG_MAX_PER_POST=5

# Next.js revalidate webhook (compose 내부: frontend 서비스명)
REVALIDATE_WEBHOOK_ENABLED=true
REVALIDATE_WEBHOOK_URL=http://frontend:3000/api/revalidate
REVALIDATE_SECRET=             # FE와 공유하는 시크릿

# Cookie (FE/BE 도메인 구성에 맞게)
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax           # FE/BE 서로 다른 사이트면 None + Secure
COOKIE_DOMAIN=